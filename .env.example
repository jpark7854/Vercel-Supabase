# ── Supabase (프로젝트 설정 > API 에서 복사) ─────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # 공개 키 (브라우저에서 파일 업로드에만 사용)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # 비밀 키 — 절대 외부 공유 금지

# ── 포털 주소 (메일 속 링크에 사용, 끝에 / 없이) ──────────────────
APP_URL=http://localhost:3000

# ── 보안 키 (각각 아래 명령으로 생성한 무작위 값) ──────────────────
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
LINK_ENC_KEY=
CRON_SECRET=

# ── 메일 (Resend) — 비워두면 메일을 보내지 않고 기록만 남깁니다 ────
RESEND_API_KEY=
MAIL_FROM=명성코퍼레이션 디자인포털 <noreply@your-domain.co.kr>
